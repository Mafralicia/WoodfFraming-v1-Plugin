<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steel Ceiling Framing"
        Width="430" Height="536"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Material (Revit):" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="cb_revit_material" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Joist Family:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  x:Name="cb_joist_type" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Rim Track Family:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  x:Name="cb_rim_type" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Spacing:" VerticalAlignment="Center" Margin="0,8"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
            <RadioButton x:Name="rb_12oc" Content='12&quot; OC' GroupName="spacing"
                         IsChecked="True" Margin="0,0,10,0"/>
            <RadioButton x:Name="rb_16oc" Content='16&quot; OC' GroupName="spacing"
                         Margin="0,0,10,0"/>
            <RadioButton x:Name="rb_24oc" Content='24&quot; OC' GroupName="spacing"
                         Margin="0,0,10,0"/>
            <RadioButton x:Name="rb_400mm" Content="400mm" GroupName="spacing"
                         Margin="0,0,10,0"/>
            <RadioButton x:Name="rb_600mm" Content="600mm" GroupName="spacing"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="rb_custom" Content="Custom (in):" GroupName="spacing"/>
            <TextBox x:Name="tb_custom_spacing" Width="50" Margin="4,0,0,0"
                     Text="16" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Text="Direction:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  x:Name="cb_layout_direction" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="Placement:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  x:Name="cb_placement" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="7" Grid.Column="0"
                   Text="Layout Style:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="7" Grid.Column="1"
                  x:Name="cb_layout_style" Margin="0,4" IsEditable="False"/>

        <TextBlock Grid.Row="8" Grid.ColumnSpan="2"
                   x:Name="tb_summary" Margin="0,10,0,0"
                   TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="btn_ok" Content="Frame" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="btn_cancel" Content="Cancel" Width="90" Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
