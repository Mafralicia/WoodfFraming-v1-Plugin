<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roof Framing Configurator"
        Width="460" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Framing Style -->
                <GroupBox Header="Framing Style">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <RadioButton x:Name="rb_style_truss" Content="Truss System" IsChecked="True" Margin="0,0,24,0" FontWeight="Normal"/>
                        <RadioButton x:Name="rb_style_stick" Content="Stick Framing (Rafters)" FontWeight="Normal"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Truss Settings -->
                <GroupBox x:Name="gb_truss_options" Header="Truss Settings">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Truss Topology:" VerticalAlignment="Center" FontWeight="Normal"/>
                        <ComboBox x:Name="cb_truss_type" Grid.Column="1" Height="24" SelectedIndex="3">
                            <ComboBoxItem Content="King Post"/>
                            <ComboBoxItem Content="Fink"/>
                            <ComboBoxItem Content="Pratt"/>
                            <ComboBoxItem Content="Dynamic (Auto)"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- 3. Spacing Options -->
                <GroupBox Header="Spacing Settings">
                    <StackPanel>
                        <!-- Truss/Rafter Spacing -->
                        <TextBlock Text="Truss / Rafter Spacing" FontWeight="Bold" Margin="0,4,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="rb_truss_16oc" Content='16" OC' Margin="0,0,16,0" FontWeight="Normal"/>
                            <RadioButton x:Name="rb_truss_24oc" Content='24" OC' IsChecked="True" Margin="0,0,16,0" FontWeight="Normal"/>
                            <RadioButton x:Name="rb_truss_custom" Content="Custom:" FontWeight="Normal"/>
                            <TextBox x:Name="tb_truss_custom" Width="50" Margin="4,0,0,0" Text="24" IsEnabled="False" Height="20" VerticalContentAlignment="Center"/>
                            <TextBlock Text=' "' VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- Ceiling Joist Spacing -->
                        <StackPanel x:Name="sp_ceiling_spacing">
                            <TextBlock Text="Ceiling Joist Spacing" FontWeight="Bold" Margin="0,4,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton x:Name="rb_ceil_16oc" Content='16" OC' IsChecked="True" Margin="0,0,16,0" FontWeight="Normal"/>
                                <RadioButton x:Name="rb_ceil_24oc" Content='24" OC' Margin="0,0,16,0" FontWeight="Normal"/>
                                <RadioButton x:Name="rb_ceil_custom" Content="Custom:" FontWeight="Normal"/>
                                <TextBox x:Name="tb_ceil_custom" Width="50" Margin="4,0,0,0" Text="16" IsEnabled="False" Height="20" VerticalContentAlignment="Center"/>
                                <TextBlock Text=' "' VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Family Mappings -->
                <GroupBox Header="Family Mappings">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top Chord / Rafter -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Top Chord / Rafter:" VerticalAlignment="Center" Margin="0,4,8,4" FontWeight="Normal"/>
                        <ComboBox x:Name="cb_tc_type" Grid.Row="0" Grid.Column="1" Height="24" Margin="0,4,0,4"/>

                        <!-- Bottom Chord / Ceiling Joist -->
                        <TextBlock x:Name="lbl_bc_type" Grid.Row="1" Grid.Column="0" Text="Bottom Chord / Joist:" VerticalAlignment="Center" Margin="0,4,8,4" FontWeight="Normal"/>
                        <ComboBox x:Name="cb_bc_type" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,4,0,4"/>

                        <!-- Web Bracing -->
                        <TextBlock x:Name="lbl_web_type" Grid.Row="2" Grid.Column="0" Text="Web Bracing:" VerticalAlignment="Center" Margin="0,4,8,4" FontWeight="Normal"/>
                        <ComboBox x:Name="cb_web_type" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,4,0,4"/>

                        <!-- Ridge Board -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ridge Board / Hips:" VerticalAlignment="Center" Margin="0,4,8,4" FontWeight="Normal"/>
                        <ComboBox x:Name="cb_ridge_type" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,4,0,4"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_ok" Content="Frame Roof" Width="100" Height="30" IsDefault="True" Margin="0,0,8,0" Background="#005A9E" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            <Button x:Name="btn_cancel" Content="Cancel" Width="80" Height="30" IsCancel="True" Background="#E0E0E0" FontWeight="Normal" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
